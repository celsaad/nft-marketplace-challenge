# Turn the MSW mock backend on or off. The demo needs it ("on"), since there is no real backend.
VITE_MOCKS=on
# Base URL of the REST API (handled by MSW when mocks are on).
VITE_API_URL=/api
# Socket.IO endpoint (intercepted by MSW's WebSocket support when mocks are on).
VITE_REALTIME_URL=wss://realtime.kurio.test
